# Frontend environment (copy to .env.local). Only VITE_* values reach the browser.

# Where the Vite dev/preview server proxies /api requests (the FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional absolute API base URL for deployments that serve the API elsewhere.
# Leave empty to use same-origin /api (recommended; the backend has no CORS middleware).
VITE_API_BASE_URL=

# Opt-in demo mode. When "true" and the model artifact is unavailable, the assessment
# screen shows an ILLUSTRATIVE, clearly watermarked result instead of an error.
# Never enable this when presenting results as real model output.
VITE_DEMO_MODE=false
